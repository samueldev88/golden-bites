# Copie para .env para desenvolvimento local. Não use estes valores em produção.
# Em produção, use uma chave aleatória exclusiva com pelo menos 50 caracteres
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Em produção: https://www.seudominio.com.br
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
# Em produção, configure DATABASE_URL para um PostgreSQL gerenciado e persistente.
# DATABASE_URL=postgresql://usuario:senha@host:5432/golden_bites

# Mercado Pago (Suas integrações > Credenciais)
# Use o Access Token de TESTE para testar e o de PRODUÇÃO para vender de verdade
MP_ACCESS_TOKEN=
# Segredo de assinatura configurado em Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=

# Produção atrás de proxy reverso (use apenas os endereços dos proxies confiáveis)
TRUSTED_PROXY_IPS=
TRUST_PROXY_SSL=0
